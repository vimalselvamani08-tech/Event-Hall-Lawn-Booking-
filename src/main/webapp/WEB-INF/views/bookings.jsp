<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Bookings | Event Hall</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"></head>
<body><%@ include file="_header.jspf" %><section class="page-heading"><div><p class="eyebrow">EVENT SCHEDULE</p><h1>Bookings</h1><p class="muted">Confirm a venue, date, time slot, and advance payment.</p></div></section>
<c:if test="${not empty error}"><p class="alert error"><c:out value="${error}"/><c:if test="${not empty nextDates}"><br>Next open dates: <c:forEach items="${nextDates}" var="date" varStatus="loop"><c:if test="${loop.index gt 0}">, </c:if><c:out value="${date}"/></c:forEach></c:if></p></c:if>
<section class="content-section form-section"><div class="section-heading"><div><p class="eyebrow">NEW RESERVATION</p><h2>Booking details</h2></div></div>
<form method="post" class="form-grid"><label>Customer<select name="customerId" required><option value="">Select customer</option><c:forEach items="${customers}" var="customer"><option value="${customer.id}"><c:out value="${customer.name}"/> · <c:out value="${customer.phone}"/></option></c:forEach></select></label>
<label>Venue<select name="venueId" required><option value="">Select venue</option><c:forEach items="${venues}" var="venue"><c:if test="${venue.status == 'ACTIVE'}"><option value="${venue.id}"><c:out value="${venue.name}"/> · capacity <c:out value="${venue.capacity}"/></option></c:if></c:forEach></select></label>
<label>Event date<input type="date" name="eventDate" min="${today}" required></label><label>Time slot<select name="slot" required><option value="">Select slot</option><option value="MORNING">Morning</option><option value="AFTERNOON">Afternoon</option><option value="EVENING">Evening</option><option value="FULL_DAY">Full day</option></select></label>
<label>Event type<input name="eventType" placeholder="Wedding reception" required></label><label>Expected guests<input type="number" name="guests" min="1" required></label><label>Advance payment<input type="number" name="advance" min="0.01" step="0.01" required></label><div class="form-actions"><button class="button primary" type="submit">Check availability &amp; book</button></div></form></section>
<section class="content-section"><div class="section-heading"><div><p class="eyebrow">RECORDS</p><h2>Booking history</h2></div><a class="text-link" href="${pageContext.request.contextPath}/admin/reports">Export and reports</a></div><div class="table-wrap"><table><thead><tr><th>Event date</th><th>Customer</th><th>Venue</th><th>Slot</th><th>Total</th><th>Paid</th><th>Balance</th><th>Status</th><th></th></tr></thead><tbody>
<c:forEach items="${bookings}" var="booking"><tr><td><c:out value="${booking.eventDate}"/></td><td><c:out value="${booking.customer.name}"/></td><td><c:out value="${booking.venue.name}"/></td><td><c:out value="${booking.slot}"/></td><td><c:out value="${booking.totalAmount}"/></td><td><c:out value="${booking.amountPaid}"/></td><td><strong><c:out value="${booking.balance}"/></strong></td><td><span class="status"><c:out value="${booking.status}"/></span></td><td class="row-actions"><c:if test="${booking.status == 'CONFIRMED'}"><a class="text-link" href="${pageContext.request.contextPath}/admin/payments?bookingId=${booking.id}">Payment</a><form method="post"><input type="hidden" name="action" value="cancel"><input type="hidden" name="bookingId" value="${booking.id}"><button class="text-button danger-text" type="submit">Cancel</button></form></c:if></td></tr></c:forEach>
<c:if test="${empty bookings}"><tr><td colspan="9" class="empty-state">No bookings recorded yet.</td></tr></c:if></tbody></table></div></section><%@ include file="_footer.jspf" %></body></html>