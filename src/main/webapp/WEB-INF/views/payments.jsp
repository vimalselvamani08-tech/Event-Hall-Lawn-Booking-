<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Payments | Event Hall</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"></head>
<body><%@ include file="_header.jspf" %><section class="page-heading"><div><p class="eyebrow">BOOKING #<c:out value="${booking.id}"/></p><h1>Payment record</h1><p class="muted"><c:out value="${booking.customer.name}"/> · <c:out value="${booking.venue.name}"/> · <c:out value="${booking.eventDate}"/></p></div></section>
<c:if test="${not empty error}"><p class="alert error"><c:out value="${error}"/></p></c:if><c:if test="${param.saved == '1'}"><p class="alert success">Installment saved and receipt generated.</p></c:if>
<section class="metric-row"><div class="metric"><span>Total amount</span><strong><c:out value="${booking.totalAmount}"/></strong></div><div class="metric"><span>Paid so far</span><strong><c:out value="${booking.amountPaid}"/></strong></div><div class="metric accent-metric"><span>Balance due</span><strong><c:out value="${booking.balance}"/></strong></div></section>
<section class="content-section form-section"><div class="section-heading"><div><p class="eyebrow">INSTALLMENT</p><h2>Record a payment</h2></div></div><form method="post" class="inline-form"><input type="hidden" name="bookingId" value="${booking.id}"><label>Amount<input name="amount" type="number" min="0.01" max="${booking.balance}" step="0.01" required></label><button class="button primary" type="submit" ${booking.balance == 0 ? 'disabled' : ''}>Record installment</button></form></section>
<section class="content-section"><div class="section-heading"><h2>Payment history</h2></div><div class="table-wrap"><table><thead><tr><th>Date</th><th>Type</th><th>Amount</th></tr></thead><tbody><c:forEach items="${payments}" var="payment"><tr><td><c:out value="${payment.paymentDate}"/></td><td><c:out value="${payment.type}"/></td><td><strong><c:out value="${payment.amount}"/></strong></td></tr></c:forEach><c:if test="${empty payments}"><tr><td colspan="3" class="empty-state">No payments recorded.</td></tr></c:if></tbody></table></div></section><%@ include file="_footer.jspf" %></body></html>