<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Customers | Event Hall</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"></head>
<body><%@ include file="_header.jspf" %><section class="page-heading"><div><p class="eyebrow">CUSTOMER DIRECTORY</p><h1>Customers</h1><p class="muted">Contact details and booking relationships.</p></div></section>
<c:if test="${not empty error}"><p class="alert error"><c:out value="${error}"/></p></c:if>
<section class="content-section"><div class="section-heading"><h2>Customer records</h2><form method="get" class="search-form"><input name="q" value="<c:out value='${query}'/>" placeholder="Name or phone"><button class="button secondary" type="submit">Search</button></form></div>
<div class="table-wrap"><table><thead><tr><th>Name</th><th>Phone</th><th>Email</th><th>Address</th><th></th></tr></thead><tbody><c:forEach items="${customers}" var="customer"><tr><td><strong><c:out value="${customer.name}"/></strong></td><td><c:out value="${customer.phone}"/></td><td><c:out value="${customer.email}"/></td><td><c:out value="${customer.address}"/></td><td class="row-actions"><a class="text-link" href="?edit=${customer.id}">Edit</a><form method="post"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="${customer.id}"><button class="text-button danger-text" type="submit">Delete</button></form></td></tr></c:forEach><c:if test="${empty customers}"><tr><td colspan="5" class="empty-state">No matching customers.</td></tr></c:if></tbody></table></div></section>
<section class="content-section form-section"><div class="section-heading"><div><p class="eyebrow">CONTACT DETAILS</p><h2><c:choose><c:when test="${not empty editing}">Edit customer</c:when><c:otherwise>Add a customer</c:otherwise></c:choose></h2></div></div>
<form method="post" class="form-grid"><input type="hidden" name="id" value="${editing.id}"><label>Full name<input name="name" value="<c:out value='${editing.name}'/>" required></label><label>Phone<input name="phone" value="<c:out value='${editing.phone}'/>" required></label><label>Email<input type="email" name="email" value="<c:out value='${editing.email}'/>"></label><label>Address<input name="address" value="<c:out value='${editing.address}'/>"></label><div class="form-actions"><button class="button primary" type="submit">Save customer</button><c:if test="${not empty editing}"><a class="button secondary" href="${pageContext.request.contextPath}/admin/customers">Cancel</a></c:if></div></form></section>
<%@ include file="_footer.jspf" %></body></html>