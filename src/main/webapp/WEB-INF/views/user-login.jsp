<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Customer sign in | Event Hall</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"></head>
<body class="login-page"><main class="login-shell"><a class="login-brand" href="${pageContext.request.contextPath}/home"><span class="brand-mark">EH</span><span>EVENT HALL<br><strong>VENUES &amp; BOOKINGS</strong></span></a><section class="login-panel"><p class="eyebrow">CUSTOMER ACCOUNT</p><h1>Welcome back</h1><p class="muted">Sign in to book a venue and view your reservations.</p>
<c:if test="${not empty error}"><p class="alert error"><c:out value="${error}"/></p></c:if><form method="post" action="${pageContext.request.contextPath}/user/login" class="form-stack"><label>Email<input type="email" name="email" autocomplete="email" required autofocus></label><label>Password<input type="password" name="password" autocomplete="current-password" required></label><button class="button primary full" type="submit">Sign in</button></form></section><p class="login-switch">New here? <a href="${pageContext.request.contextPath}/user/signup">Create a customer account</a></p><p class="login-foot"><a href="${pageContext.request.contextPath}/login">Administrator sign in</a></p></main></body></html>