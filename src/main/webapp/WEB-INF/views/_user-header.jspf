<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<header class="topbar"><a class="brand" href="${pageContext.request.contextPath}/home"><span class="brand-mark">EH</span><span>Event Hall<br><strong>MY RESERVATIONS</strong></span></a><nav class="main-nav"><a href="${pageContext.request.contextPath}/home">Browse venues</a><a href="${pageContext.request.contextPath}/user/bookings">My bookings</a></nav><div class="account"><span class="account-name"><c:out value="${sessionScope.customer.name}"/></span><form method="post" action="${pageContext.request.contextPath}/logout"><button class="button quiet" type="submit">Sign out</button></form></div></header><main class="page-shell">