<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Create customer account | Event Hall</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"></head>
<body class="login-page"><main class="login-shell signup-shell"><a class="login-brand" href="${pageContext.request.contextPath}/home"><span class="brand-mark">EH</span><span>EVENT HALL<br><strong>VENUES &amp; BOOKINGS</strong></span></a><section class="login-panel"><p class="eyebrow">CUSTOMER ACCOUNT</p><h1>Create your account</h1><p class="muted">Save your contact details and reserve an event space.</p>
<c:if test="${not empty error}"><p class="alert error"><c:out value="${error}"/></p></c:if><form method="post" action="${pageContext.request.contextPath}/user/signup" class="form-stack"><label>Full name<input name="name" maxlength="160" autocomplete="name" required></label><label>Phone<input name="phone" maxlength="30" autocomplete="tel" required></label><label>Email<input type="email" name="email" maxlength="160" autocomplete="email" required></label><label>Address <span class="optional">OPTIONAL</span><input name="address" maxlength="500" autocomplete="street-address"></label><label>Password<input type="password" name="password" minlength="10" maxlength="72" autocomplete="new-password" required><small class="field-hint">Use at least 10 characters.</small></label><label>Confirm password<input type="password" name="confirmPassword" minlength="10" maxlength="72" autocomplete="new-password" required></label><button class="button primary full" type="submit">Create account</button></form></section><p class="login-switch">Already registered? <a href="${pageContext.request.contextPath}/user/login">Sign in</a></p></main></body></html>