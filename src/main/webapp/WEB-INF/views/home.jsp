<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Find your venue | Event Hall</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css?v=4"></head>
<body>
<header class="topbar public-topbar"><a class="brand" href="${pageContext.request.contextPath}/home"><span class="brand-mark">EH</span><span>Event Hall<br><strong>VENUES &amp; BOOKINGS</strong></span></a><nav class="main-nav"><a href="#venues">Venues</a><a href="${pageContext.request.contextPath}/login">Admin</a></nav><div class="account"><a class="button quiet" href="${pageContext.request.contextPath}/user/login">Customer sign in</a><a class="button primary" href="${pageContext.request.contextPath}/user/signup">Create account</a></div></header>
<main class="page-shell public-shell">
    <section class="public-intro"><div><p class="eyebrow">CELEBRATE TOGETHER</p><h1>Find a place for<br>your gathering.</h1><p class="muted">Explore available marriage halls, lawns, and convention spaces, then reserve your date online.</p><a class="button primary" href="#venues">Explore venues <span aria-hidden="true">↓</span></a></div><div class="intro-stamp"><span>MAKE ROOM</span><strong>for<br>good days</strong><small>VENUES · EVENTS · COMMUNITY</small></div></section>
    <section id="venues" class="content-section venue-directory"><div class="section-heading"><div><p class="eyebrow">OUR SPACES</p><h2>Available venues</h2></div><span class="muted"><c:out value="${venues.size()}"/> spaces</span></div>
        <c:url var="communityPavilionImage" value="/assets/community-pavilion.jpg"/>
        <c:url var="rosewoodMarriageHallImage" value="/assets/rosewood-marriage-hall.jpg"/>
        <div class="venue-grid"><c:forEach items="${venues}" var="venue"><article class="venue-card"><img class="venue-card-image${venue.name == 'Community Pavilion' ? ' community-pavilion-image' : (venue.name == 'Rosewood Marriage Hall' ? ' rosewood-marriage-image' : '')}" src="${venue.name == 'Community Pavilion' ? communityPavilionImage : (venue.name == 'Rosewood Marriage Hall' ? rosewoodMarriageHallImage : (empty venue.imageUrl ? 'https://images.unsplash.com/photo-1519167758481-83f550bb3bec?auto=format&fit=crop&w=1200&q=80' : venue.imageUrl))}" alt="<c:out value='${venue.name}'/>"><div class="venue-card-body"><div class="venue-card-top"><span class="venue-icon">EH</span><span class="status">AVAILABLE</span></div><p class="eyebrow"><c:choose><c:when test="${venue.type == 'MARRIAGE_HALL'}">MARRIAGE HALL</c:when><c:when test="${venue.type == 'COMMUNITY_CENTER'}">COMMUNITY CENTER</c:when><c:when test="${venue.type == 'OUTDOOR_LAWN'}">OUTDOOR LAWN</c:when><c:otherwise>CONVENTION HALL</c:otherwise></c:choose></p><h3><c:out value="${venue.name}"/></h3><p class="venue-description"><c:out value="${not empty venue.description ? venue.description : venue.facilities}"/></p><p class="venue-facilities"><c:out value="${venue.facilities}"/></p><div class="venue-meta"><span>CAPACITY <strong><c:out value="${venue.capacity}"/></strong></span><span>FROM <strong>$<c:out value="${venue.baseRent}"/></strong></span></div><a class="text-link" href="${pageContext.request.contextPath}/user/signup">Create account to book <span aria-hidden="true">→</span></a></div></article></c:forEach>
        <c:if test="${empty venues}"><p class="empty-state">No active venues are listed right now.</p></c:if></div>
    </section>
    <section class="visitor-callout"><div><p class="eyebrow">YOUR EVENT STARTS HERE</p><h2>Dates fill quickly.<br>Make your account to reserve a space.</h2></div><div class="visitor-actions"><a class="button primary" href="${pageContext.request.contextPath}/user/signup">Sign up</a><a class="text-link" href="${pageContext.request.contextPath}/user/login">I already have an account</a></div></section>
</main><footer class="footer"><span>Event Hall Management</span><span>Venue reservations for celebrations and community events.</span></footer>
</body></html>