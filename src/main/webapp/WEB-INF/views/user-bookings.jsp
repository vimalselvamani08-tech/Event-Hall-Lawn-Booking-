<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>My bookings | Event Hall</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css?v=4"></head>
<body><%@ include file="_user-header.jspf" %><section class="page-heading"><div><p class="eyebrow">CUSTOMER PORTAL</p><h1>Book a venue</h1><p class="muted">Choose your event date and space. An advance payment is required to confirm.</p></div><a class="button secondary" href="${pageContext.request.contextPath}/home">Browse all venues</a></section>
<c:if test="${not empty sessionScope.notice}"><p class="alert success"><c:out value="${sessionScope.notice}"/></p><c:remove var="notice" scope="session"/></c:if><c:if test="${not empty error}"><p class="alert error"><c:out value="${error}"/><c:if test="${not empty nextDates}"><br>Next available dates: <c:forEach items="${nextDates}" var="date" varStatus="loop"><c:if test="${loop.index gt 0}">, </c:if><c:out value="${date}"/></c:forEach></c:if></p></c:if>
<section class="content-section form-section"><div class="section-heading"><div><p class="eyebrow">NEW RESERVATION</p><h2>Event details</h2></div></div><form method="post" action="${pageContext.request.contextPath}/user/bookings" class="form-grid"><label>Venue<select name="venueId" required><option value="">Choose a venue</option><c:forEach items="${venues}" var="venue"><option value="${venue.id}"><c:out value="${venue.name}"/> · up to <c:out value="${venue.capacity}"/> guests</option></c:forEach></select></label><label>Event date<input type="date" name="eventDate" min="${today}" required></label><label>Time slot<select name="slot" required><option value="">Choose a slot</option><option value="MORNING">Morning</option><option value="AFTERNOON">Afternoon</option><option value="EVENING">Evening</option><option value="FULL_DAY">Full day</option></select></label><label>Event type<input name="eventType" placeholder="Wedding reception" maxlength="100" required></label><label>Expected guests<input type="number" name="guests" min="1" required></label><label>Advance payment<input type="number" name="advance" min="0.01" step="0.01" required></label><div class="form-actions"><button class="button primary" type="submit">Check availability &amp; reserve</button></div></form></section>
<section class="content-section"><div class="section-heading"><div><p class="eyebrow">YOUR ACCOUNT</p><h2>Booking history</h2></div></div><div class="table-wrap"><table><thead><tr><th>Date</th><th>Event</th><th>Venue</th><th>Slot</th><th>Total</th><th>Paid</th><th>Balance</th><th>Status</th></tr></thead><tbody><c:forEach items="${bookings}" var="booking"><tr><td><c:out value="${booking.eventDate}"/></td><td><c:out value="${booking.eventType}"/></td><td><c:out value="${booking.venue.name}"/></td><td><c:out value="${booking.slot}"/></td><td><c:out value="${booking.totalAmount}"/></td><td><c:out value="${booking.amountPaid}"/></td><td><strong><c:out value="${booking.balance}"/></strong></td><td><span class="status"><c:out value="${booking.status}"/></span></td></tr></c:forEach><c:if test="${empty bookings}"><tr><td colspan="8" class="empty-state">Your reservations will appear here.</td></tr></c:if></tbody></table></div></section>
<%@ include file="_footer.jspf" %></body></html>
