<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Reports | Event Hall</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"></head>
<body><%@ include file="_header.jspf" %><section class="page-heading"><div><p class="eyebrow">REPORTS &amp; RECORDS</p><h1>Reports</h1><p class="muted">Upcoming events, outstanding balances, and booking history.</p></div><a class="button secondary" href="${pageContext.request.contextPath}/admin/reports?export=csv">Download CSV</a></section>
<section class="content-section"><div class="section-heading"><div><p class="eyebrow">COLLECTIONS</p><h2>Pending payments</h2></div></div><div class="table-wrap"><table><thead><tr><th>Customer</th><th>Venue</th><th>Event date</th><th>Total</th><th>Paid</th><th>Pending</th></tr></thead><tbody><c:forEach items="${pending}" var="booking"><tr><td><c:out value="${booking.customer.name}"/></td><td><c:out value="${booking.venue.name}"/></td><td><c:out value="${booking.eventDate}"/></td><td><c:out value="${booking.totalAmount}"/></td><td><c:out value="${booking.amountPaid}"/></td><td><strong><c:out value="${booking.balance}"/></strong></td></tr></c:forEach><c:if test="${empty pending}"><tr><td colspan="6" class="empty-state">No outstanding balances.</td></tr></c:if></tbody></table></div></section>
<section class="content-section"><div class="section-heading"><div><p class="eyebrow">SCHEDULE</p><h2>Upcoming events</h2></div></div><div class="table-wrap"><table><thead><tr><th>Date</th><th>Event</th><th>Customer</th><th>Venue</th><th>Status</th></tr></thead><tbody><c:forEach items="${upcoming}" var="booking"><tr><td><c:out value="${booking.eventDate}"/></td><td><c:out value="${booking.eventType}"/></td><td><c:out value="${booking.customer.name}"/></td><td><c:out value="${booking.venue.name}"/></td><td><c:out value="${booking.status}"/></td></tr></c:forEach><c:if test="${empty upcoming}"><tr><td colspan="5" class="empty-state">No upcoming events.</td></tr></c:if></tbody></table></div></section>
<section class="content-section form-section"><div class="section-heading"><div><p class="eyebrow">CUSTOMER ACCOUNT</p><h2>Payment history</h2></div></div><form method="get" class="inline-form"><label>Customer<select name="customerId" required><option value="">Choose a customer</option><c:forEach items="${customers}" var="customer"><option value="${customer.id}" ${param.customerId == customer.id ? 'selected' : ''}><c:out value="${customer.name}"/> · <c:out value="${customer.phone}"/></option></c:forEach></select></label><button class="button secondary" type="submit">View history</button></form>
<c:if test="${not empty customerHistory}"><h3>Bookings</h3><div class="table-wrap"><table><thead><tr><th>Date</th><th>Venue</th><th>Total</th><th>Paid</th><th>Balance</th><th>Status</th></tr></thead><tbody><c:forEach items="${customerHistory}" var="booking"><tr><td><c:out value="${booking.eventDate}"/></td><td><c:out value="${booking.venue.name}"/></td><td><c:out value="${booking.totalAmount}"/></td><td><c:out value="${booking.amountPaid}"/></td><td><c:out value="${booking.balance}"/></td><td><c:out value="${booking.status}"/></td></tr></c:forEach></tbody></table></div><h3>Payments</h3><div class="table-wrap"><table><thead><tr><th>Payment date</th><th>Booking</th><th>Type</th><th>Amount</th></tr></thead><tbody><c:forEach items="${customerPayments}" var="payment"><tr><td><c:out value="${payment.paymentDate}"/></td><td><c:out value="${payment.bookingId}"/></td><td><c:out value="${payment.type}"/></td><td><c:out value="${payment.amount}"/></td></tr></c:forEach></tbody></table></div></c:if></section>
<section class="content-section"><div class="section-heading"><h2>Booking history</h2></div><div class="table-wrap"><table><thead><tr><th>Date</th><th>Customer</th><th>Venue</th><th>Event</th><th>Status</th><th>Balance</th></tr></thead><tbody><c:forEach items="${history}" var="booking"><tr><td><c:out value="${booking.eventDate}"/></td><td><c:out value="${booking.customer.name}"/></td><td><c:out value="${booking.venue.name}"/></td><td><c:out value="${booking.eventType}"/></td><td><c:out value="${booking.status}"/></td><td><c:out value="${booking.balance}"/></td></tr></c:forEach></tbody></table></div></section>
<%@ include file="_footer.jspf" %></body></html>