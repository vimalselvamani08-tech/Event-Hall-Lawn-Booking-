<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>New administrator | Event Hall</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"></head>
<body><%@ include file="_header.jspf" %><section class="page-heading"><div><p class="eyebrow">ACCESS CONTROL</p><h1>Create administrator</h1><p class="muted">Only signed-in administrators can create another admin account.</p></div></section>
<c:if test="${not empty error}"><p class="alert error"><c:out value="${error}"/></p></c:if><c:if test="${not empty success}"><p class="alert success"><c:out value="${success}"/></p></c:if>
<section class="content-section form-section account-form"><div class="section-heading"><h2>Administrator credentials</h2></div><form method="post" action="${pageContext.request.contextPath}/admin/signup" class="form-stack"><label>Username<input name="username" minlength="3" maxlength="40" pattern="[A-Za-z0-9._-]+" autocomplete="username" required><small class="field-hint">3-40 letters, numbers, dots, dashes, or underscores.</small></label><label>Password<input type="password" name="password" minlength="10" maxlength="72" autocomplete="new-password" required></label><label>Confirm password<input type="password" name="confirmPassword" minlength="10" maxlength="72" autocomplete="new-password" required></label><button class="button primary" type="submit">Create admin account</button></form></section><%@ include file="_footer.jspf" %></body></html>